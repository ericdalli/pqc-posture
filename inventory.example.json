{
  "version": 1,

  "defaults": {
    "port": 443,
    "repeat": 1,
    "frontend_repeat": 5
  },

  "services": [
    {
      "service": "def.company.com",
      "vip": { "ip": "10.1.1.3", "port": 443, "tls_mode": "passthrough" },
      "backends": ["30.1.1.2", "30.1.1.3"]
    },

    {
      "service": "abc.company.com",
      "sni": "abc.company.com",
      "frontend": {
        "type": "f5",
        "ip": "10.1.1.10",
        "port": 443,
        "tls_mode": "reencrypt",
        "repeat": 12,
        "notes": "LTM round-robin, 4 pool members, source-addr persistence ON"
      },
      "backends": [
        { "ip": "30.1.2.11", "port": 8443, "label": "web01" },
        { "ip": "30.1.2.12", "port": 8443, "label": "web02" },
        { "ip": "30.1.2.13", "port": 8443, "label": "web03", "sni": "abc.internal.local" }
      ],
      "notes": "internal SNI differs on web03 after the vhost split"
    },

    {
      "service": "origin-direct.company.com",
      "frontend": { "type": "none", "ip": "origin-direct.company.com" }
    },

    {
      "service": "edge.company.com",
      "frontend": { "type": "unknown", "ip": "203.0.113.20", "repeat": 8 },
      "backends": []
    },

    {
      "service": "pqc-lab-fd.azurefd.net",
      "frontend": {
        "type": "azure_front_door",
        "ip": "pqc-lab-fd.azurefd.net",
        "tls_mode": "reencrypt",
        "repeat": 10
      },
      "backends": ["pqc-lab-appgw.eastus.cloudapp.azure.com"],
      "notes": "hop 1 of 3; App Gateway declared separately below"
    },

    {
      "service": "pqc-lab-appgw.eastus.cloudapp.azure.com",
      "sni": "pqc-lab-fd.azurefd.net",
      "frontend": {
        "type": "azure_app_gateway",
        "ip": "20.62.132.10",
        "tls_mode": "reencrypt",
        "repeat": 6
      },
      "backends": [
        { "ip": "pqc-lab-app.azurewebsites.net", "label": "app-service" },
        { "ip": "10.20.0.4", "port": 443, "label": "nginx-openssl35" }
      ],
      "notes": "hop 2 of 3; SNI pinned to the Front Door hostname the listener expects"
    },

    {
      "service": "legacy-mgmt.company.com",
      "frontend": {
        "type": "palo_alto",
        "ip": "2001:db8:1::25",
        "port": 8443,
        "tls_mode": "terminate"
      },
      "backends": [{ "ip": "2001:db8:2::11", "port": 8443 }]
    }
  ]
}
